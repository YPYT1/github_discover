{
  "name": "github-discover",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "demo:dev": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "test:demo": "node scripts/verify-demo.mjs",
    "demo:deploy": "pnpm demo:build && wrangler deploy --config demo/wrangler.jsonc",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:ui": "node scripts/verify-ui.mjs",
    "test:worker": "node scripts/verify-worker.mjs",
    "test:static": "node scripts/verify-static-home.mjs",
    "test:home-live": "node --use-env-proxy scripts/verify-home-live.mjs",
    "cf:build": "opennextjs-cloudflare build && node scripts/package-static-home.mjs && pnpm test:static",
    "preview": "pnpm cf:build && opennextjs-cloudflare preview",
    "deploy": "pnpm cf:build && opennextjs-cloudflare deploy",
    "db:migrate:local": "wrangler d1 migrations apply github-discover --local",
    "db:migrate:remote": "wrangler d1 migrations apply github-discover --remote",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.9",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-slot": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "miniflare": "4.20260730.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
